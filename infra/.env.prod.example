# Salin ke /opt/gedklin/.env di VM. Jangan di-commit.
# Buat secret acak dengan: openssl rand -hex 32

# Database (dipakai service db dan untuk menyusun DATABASE_URL)
POSTGRES_PASSWORD=ganti-dengan-string-acak

# API
JWT_SECRET=ganti-dengan-string-acak-panjang
CORS_ORIGINS=https://gedklin.my.id
PUBLIC_TRACKING_URL=https://gedklin.my.id/lacak
DELAY_THRESHOLD_HOURS=6
ETA_TOLERANCE_HOURS=6

# WhatsApp: console (hanya log) atau fonnte (WA_API_KEY = token device dari dashboard Fonnte)
WA_PROVIDER=console
WA_API_KEY=

# Akun owner pertama (dibuat sekali saat deploy pertama, ganti password setelah login)
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=ganti-password-owner

# Email untuk notifikasi sertifikat Let's Encrypt
ACME_EMAIL=admin@gedklin.my.id

# Tag image yang dijalankan (diisi otomatis oleh workflow Deploy)
IMAGE_TAG=latest
