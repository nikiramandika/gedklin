DATABASE_URL=postgresql+psycopg://gedklin:gedklin@localhost:5432/gedklin
REDIS_URL=redis://localhost:6379/0
# console (hanya log), fonnte (WA_API_KEY = token device Fonnte),
# atau openwa (WA_API_KEY = API key OpenWA, isi juga OPENWA_URL dan OPENWA_SESSION_ID)
WA_PROVIDER=console
WA_API_KEY=
OPENWA_URL=http://localhost:2785
# UUID session dari dashboard OpenWA (bukan nama session)
OPENWA_SESSION_ID=
JWT_SECRET=ganti-dengan-string-acak-panjang
CORS_ORIGINS=http://localhost:3000
PUBLIC_TRACKING_URL=http://localhost:3000/lacak
# Jalankan task Celery langsung tanpa Redis (dev tanpa worker / test)
CELERY_TASK_ALWAYS_EAGER=false
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=ganti-password-owner
