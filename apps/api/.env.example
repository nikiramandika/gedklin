DATABASE_URL=postgresql+psycopg://gedklin:gedklin@localhost:5432/gedklin
REDIS_URL=redis://localhost:6379/0
MODEL_PATH=../../ml/models/best_model.joblib
# Kirim WA keterlambatan bila ETA mundur lebih dari N jam (menunggu kesepakatan mitra)
DELAY_THRESHOLD_HOURS=6
# Batas error (jam) agar perkiraan dihitung "tepat" di dasbor
ETA_TOLERANCE_HOURS=6
WA_PROVIDER=console
WA_API_KEY=
JWT_SECRET=ganti-dengan-string-acak-panjang
CORS_ORIGINS=http://localhost:3000
PUBLIC_TRACKING_URL=http://localhost:3000/lacak
# Jalankan task Celery langsung tanpa Redis (dev tanpa worker / test)
CELERY_TASK_ALWAYS_EAGER=false
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=ganti-password-owner
